<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sandbox.home.mapper.AiConversationMapper">

    <resultMap type="com.sandbox.home.entity.AiConversationDO" id="AiConversationMap">
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="business" column="business" jdbcType="VARCHAR"/>
        <result property="identityType" column="identity_type" jdbcType="VARCHAR"/>
        <result property="identifier" column="identifier" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="delFlag" column="del_flag" jdbcType="INTEGER"/>
        <result property="createDate" column="create_date" jdbcType="TIMESTAMP"/>
        <result property="updateDate" column="update_date" jdbcType="TIMESTAMP"/>
    </resultMap>
    
    <sql id="Base_Column_List">
`id`, `business`, `identity_type`, `identifier`, `name`, `del_flag`, `create_date`, `update_date`    </sql>
    
    <sql id="Insert_Base_Column_List">
`id`, `business`, `identity_type`, `identifier`, `name`
    </sql>
    
    <!-- 批量插入 -->
    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO
            t_ai_conversation
        (<include refid="Insert_Base_Column_List"/>)
        VALUES
        <foreach collection="entities" item="entity" separator=",">
        (#{entity.id}, #{entity.business}, #{entity.identityType}, #{entity.identifier}, #{entity.name})
        </foreach>
    </insert>
</mapper>

